{
  "name": "@tamer4lynx/tamer-dev-client",
  "version": "0.0.8",
  "publishConfig": {
    "access": "public",
    "tag": "prerelease"
  },
  "type": "module",
  "description": "Native dev client module for Tamer4Lynx - QR scan, discovery, URL persistence, reload bridge, embedded dev launcher UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamer4lynx/tamer-dev-client.git"
  },
  "homepage": "https://github.com/tamer4lynx/tamer-dev-client#readme",
  "bugs": {
    "url": "https://github.com/tamer4lynx/tamer-dev-client/issues"
  },
  "main": "dist/dev-client.js",
  "types": "dist/dev-client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev-client.d.ts",
      "import": "./dist/dev-client.js",
      "default": "./dist/dev-client.js"
    }
  },
  "scripts": {
    "build": "rspeedy build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.112.0"
  },
  "dependencies": {
    "react-router": "^6.28.0",
    "@tamer4lynx/tamer-app-shell": "^0.0.2",
    "@tamer4lynx/tamer-insets": "^0.0.1",
    "@tamer4lynx/tamer-system-ui": "^0.0.1",
    "@tamer4lynx/tamer-plugin": "^0.0.1",
    "@tamer4lynx/tamer-router": "^0.0.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-type-check": "1.2.3",
    "@types/react": "^18.3.23",
    "typescript": "~5.8.3"
  },
  "author": "Nanofuxion",
  "license": "MIT",
  "files": [
    "dist",
    "android/src",
    "android/build.gradle.kts",
    "android/templates",
    "ios",
    "lynx.config.ts",
    "lynx.ext.json"
  ]
}
